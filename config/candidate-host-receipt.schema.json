{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex-praetor.local/schema/candidate-host-receipt/v2",
  "title": "Codex Praetor candidate host receipt",
  "type": "object",
  "required": ["schema", "status", "pull_request", "candidate", "artifact", "host_runtime", "user_path", "accepted_at"],
  "properties": {
    "schema": { "const": "codex-praetor-candidate-host-receipt/v2" },
    "status": { "const": "accepted" },
    "pull_request": { "type": "object", "required": ["number", "head_sha"] },
    "candidate": { "type": "object", "required": ["version", "content_tree", "generation_id", "runtime_contract_sha256"] },
    "artifact": { "type": "object", "required": ["zip_sha256", "candidate_receipt_sha256"] },
    "host_runtime": { "type": "object", "required": ["version", "generation_id", "runtime_contract_sha256", "source_sha256"] },
    "user_path": {
      "type": "object",
      "required": ["evidence_sha256", "entry", "route", "preflight", "dispatch", "completion", "acceptance"],
      "properties": {
        "evidence_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "entry": { "type": "object", "required": ["kind", "skill_sha256"] },
        "route": { "type": "object", "required": ["result"] },
        "preflight": { "type": "object", "required": ["kind", "base_commit", "immutable_paths", "required_checks", "worker_started"] },
        "dispatch": { "type": "object", "required": ["job_id", "execution_worktree", "provider", "model", "connection_mode", "worker_started"] },
        "completion": { "type": "object", "required": ["status", "exit_code", "worktree_head"] },
        "acceptance": { "type": "object", "required": ["verdict", "governance_state", "required_checks_passed"] }
      }
    },
    "checks": { "type": "array" },
    "accepted_at": { "type": "string", "minLength": 1 }
  }
}
