{
  "timezone": "Asia/Shanghai",
  "policy": {
    "assumeQoderPlanCreditsExpireDays": 25,
    "offPeakStart": "22:00",
    "offPeakEnd": "08:00",
    "defaultDayTier": "codebuddy-free",
    "defaultNightTier": "qoder-night-cheap",
    "defaultPreferQoderDayTier": "qoder-day-cheap",
    "denyAutoModelByDefault": true,
    "disableContinuationByDefault": true,
    "defaultReasoningEffort": "medium",
    "maxReasoningEffortWithoutApproval": "high"
  },
  "providers": {
    "qoder": {
      "cliPath": "C:\\Path\\To\\qodercli.exe",
      "versionCommand": ["--version"],
      "distribution": "qoder_cn",
      "allowedModels": ["Qwen3.7-Plus", "Qwen3.7-Max"],
      "knownButNotDefaultModels": [
        "Qwen3.8-Max",
        "Qwen3.6-Flash",
        "DeepSeek-V4-Pro",
        "DeepSeek-V4-Flash",
        "GLM-5.2",
        "Kimi-K2.7-Code",
        "MiniMax-M2.7"
      ],
      "blockedModels": ["Auto"],
      "effortFlag": "--reasoning-effort",
      "agentFlag": "--agent",
      "contextWindowFlag": "--context-window",
      "defaultOutputFormat": "text",
      "supportsJsonSchema": false,
      "connectionMode": "supervised_cli_stream_json",
      "notes": "Set distribution explicitly. qoder_cn always uses QoderWork CN's documented print/stream-json protocol; qoder_global is a separate opt-in route and must set connectionMode=qoder_agent_sdk after its own validation. Codex Praetor never chooses a global CLI from PATH, ships, replaces, or copies a Qoder CLI. Confirm login and credits in Qoder before real dispatch."
    },
    "codebuddy": {
      "nodePath": "node",
      "cliPath": "C:\\Path\\To\\codebuddy",
      "versionCommand": ["--version"],
      "distribution": "codebuddy_cn",
      "connectionMode": "codebuddy_acp",
      "blockedModels": ["auto"],
      "allowedModels": ["hy3"],
      "knownButNotDefaultModels": ["hy3-preview-agent", "deepseek-v4-flash", "deepseek-v4-pro"],
      "trustedExtraModels": [
        {
          "modelDisplay": "Hy3",
          "modelCli": "hy3",
          "reason": "Tencent Cloud CodeBuddy documentation has used hy3 as a fixed model id; verify availability and cost in your own account before large runs."
        },
        {
          "modelDisplay": "Hy3 preview",
          "modelCli": "hy3-preview-agent",
          "reason": "Known paid/preview route; not selected by default."
        },
        {
          "modelDisplay": "DeepSeek-V4-Pro",
          "modelCli": "deepseek-v4-pro",
          "reason": "Optional stronger fallback; verify cost in your own account."
        },
        {
          "modelDisplay": "DeepSeek-V4-Flash",
          "modelCli": "deepseek-v4-flash",
          "reason": "Optional cheaper fallback; verify cost in your own account."
        }
      ],
      "effortFlag": "--effort",
      "agentFlag": "--agent",
      "defaultOutputFormat": "text",
      "supportsJsonSchema": true,
      "notes": "Install CodeBuddy or WorkBuddy CLI, then set nodePath and cliPath in a local config. codebuddy_acp is the only supported route; daemon is not used. The auto model is blocked. DeepSeek entries stay manual candidates until this exact CLI identity has a recorded ACP model handshake."
    }
  },
  "tiers": {
    "qoder-night-cheap": {
      "provider": "qoder",
      "modelDisplay": "Qwen3.7-Plus",
      "modelCli": "Qwen3.7-Plus",
      "creditMultiplier": "0.1x daytime; 0.04x 22:00-08:00 UTC+8 (snapshot 2026-08-09)",
      "allowedWindow": "22:00-08:00 UTC+8",
      "reasoningEffort": "medium",
      "contextWindow": 200000,
      "outputFormat": "text",
      "permissionProfile": "readonly-or-worktree",
      "role": "normal worker, cheaper Qoder off-peak when available"
    },
    "qoder-night-strong": {
      "provider": "qoder",
      "modelDisplay": "Qwen3.7-Max",
      "modelCli": "Qwen3.7-Max",
      "creditMultiplier": "0.5x daytime; 0.1x 22:00-08:00 UTC+8 (snapshot 2026-08-09; explicit tier only)",
      "allowedWindow": "22:00-08:00 UTC+8",
      "reasoningEffort": "high",
      "contextWindow": 400000,
      "outputFormat": "text",
      "permissionProfile": "readonly-or-worktree",
      "role": "harder worker tasks during off-peak"
    },
    "qoder-day-cheap": {
      "provider": "qoder",
      "modelDisplay": "Qwen3.7-Plus",
      "modelCli": "Qwen3.7-Plus",
      "creditMultiplier": "0.1x daytime; 0.04x 22:00-08:00 UTC+8 (snapshot 2026-08-09)",
      "allowedWindow": "08:00-22:00 UTC+8",
      "reasoningEffort": "medium",
      "contextWindow": 200000,
      "outputFormat": "text",
      "permissionProfile": "readonly-or-worktree",
      "role": "daytime Qoder fallback"
    },
    "qoder-day-strong": {
      "provider": "qoder",
      "modelDisplay": "Qwen3.7-Max",
      "modelCli": "Qwen3.7-Max",
      "creditMultiplier": "0.5x daytime; 0.1x 22:00-08:00 UTC+8 (snapshot 2026-08-09; explicit tier only)",
      "allowedWindow": "08:00-22:00 UTC+8",
      "reasoningEffort": "high",
      "contextWindow": 400000,
      "outputFormat": "text",
      "permissionProfile": "readonly-or-worktree",
      "role": "daytime stronger Qoder fallback"
    },
    "codebuddy-free": {
      "provider": "codebuddy",
      "modelDisplay": "Hy3",
      "modelCli": "hy3",
      "creditMultiplier": "provider-defined; verify in your account",
      "allowedWindow": "any",
      "reasoningEffort": "medium",
      "outputFormat": "text",
      "permissionProfile": "readonly-or-worktree",
      "role": "default CodeBuddy fixed-model worker; no auto model selection"
    },
    "codebuddy-cheap": {
      "provider": "codebuddy",
      "modelDisplay": "DeepSeek-V4-Flash",
      "modelCli": "deepseek-v4-flash",
      "creditMultiplier": "provider-defined; verify in your account",
      "allowedWindow": "any",
      "reasoningEffort": "medium",
      "outputFormat": "text",
      "permissionProfile": "readonly-or-worktree",
      "role": "cheap CodeBuddy fallback"
    },
    "codebuddy-strong": {
      "provider": "codebuddy",
      "modelDisplay": "DeepSeek-V4-Pro",
      "modelCli": "deepseek-v4-pro",
      "creditMultiplier": "provider-defined; verify in your account",
      "allowedWindow": "any",
      "reasoningEffort": "high",
      "outputFormat": "text",
      "permissionProfile": "readonly-or-worktree",
      "role": "stronger CodeBuddy fallback for harder bounded tasks"
    }
  }
}
