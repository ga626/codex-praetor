{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex-praetor.local/schema/provider-release-evidence/v2",
  "title": "Codex Praetor provider release evidence",
  "type": "object",
  "required": ["schema", "status", "product", "version", "head", "artifact_sha256", "provider_surface_sha256", "compatibility_scope", "providers"],
  "properties": {
    "schema": { "const": "codex-praetor-provider-release-evidence/v2" },
    "status": { "const": "accepted" },
    "product": { "const": "codex-praetor" },
    "version": { "type": "string", "minLength": 1 },
    "head": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "source_head": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "artifact_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "provider_surface_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "generated_at": { "type": "string", "minLength": 1 },
    "compatibility_scope": { "enum": ["unchanged", "changed"] },
    "providers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["provider", "distribution", "job_id", "task_id", "evidence_kind", "model", "connection_mode", "cli_hash", "provider_compatibility_fingerprint", "completion_status", "exit_code", "evidence_state", "artifact_state", "governance_state", "repository_clean", "accepted"],
        "properties": {
          "provider": { "enum": ["qoder", "codebuddy"] },
          "distribution": { "enum": ["qoder_cn", "qoder_global", "codebuddy_cn"] },
          "job_id": { "type": "string", "minLength": 1 },
          "task_id": { "type": "string", "minLength": 1 },
          "evidence_kind": { "const": "real_task" },
          "model": { "type": "string", "minLength": 1 },
          "connection_mode": { "enum": ["supervised_cli_stream_json", "qoder_agent_sdk", "codebuddy_acp"] },
          "cli_hash": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
          "provider_compatibility_fingerprint": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
          "completion_status": { "const": "process_exited" },
          "exit_code": { "const": 0 },
          "evidence_state": { "const": "report_valid" },
          "artifact_state": { "const": "report_observed" },
          "governance_state": { "const": "accepted" },
          "repository_clean": { "const": true },
          "accepted": { "const": true },
          "accepted_at": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
