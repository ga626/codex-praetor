    "skills":  "./skills/",
    "mcpServers":  "./.mcp.json",
    "interface":  {
                      "displayName":  "Codex 执行官",
                      "shortDescription":  "让 Codex 监督 Qoder 和 CodeBuddy 完成边界清楚的外部任务。",
                      "longDescription":  "Codex Praetor 提供 Codex 执行官模式：Codex 拆分任务、先评估外派阶段、派发边界清楚的工作、跟踪真实状态，并验收来自 Qoder、CodeBuddy 外部 CLI worker 的结果。Codex 始终负责规划、风险判断、整合和最终验证。",
                      "developerName":  "Codex Praetor",
                      "category":  "Productivity",
                      "capabilities":  [
                                           "Interactive",
                                           "Read",
                                           "Write"
                                       ],
                      "websiteURL":  "https://github.com/ga626/codex-praetor",
                      "privacyPolicyURL":  "https://github.com/ga626/codex-praetor/blob/main/docs/user/privacy.zh.md",
                      "termsOfServiceURL":  "https://github.com/ga626/codex-praetor/blob/main/SECURITY.md",
                      "defaultPrompt":  [
                                            "开启 Codex 执行官模式；后续任务先评估是否适合外派。",
                                            "拆分一下任务，先做 dry-run，不要真实修改文件。",
                                            "用 Codex Praetor 把这个只读审计交给外部 agent，并在结果回来后验收。",
                                            "检查当前 repo 是否适合派给 Qoder 或 CodeBuddy；如果适合，给出派工和验收计划。"
                                        ],
                      "brandColor":  "#7C3AED",
                      "screenshots":  [
                                          "https://raw.githubusercontent.com/ga626/codex-praetor/main/docs/assets/codex-praetor-dry-run.svg"
                                      ]
                  }
}
